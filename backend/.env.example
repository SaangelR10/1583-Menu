# PostgreSQL (Neon en produccion, o local para desarrollo)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Firma de los JWT de acceso (15 min). Genera uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=""

# Clave para cifrar el secreto TOTP de 2FA en reposo (AES-256-GCM, minimo 32 caracteres).
# Genera una con: openssl rand -base64 32
TWO_FACTOR_ENC_KEY=""

# Credenciales del primer administrador — usadas SOLO por `npm run prisma:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Origenes permitidos para el API publico (GET /api/v1/menu y /api/v1/store-info), separados por coma.
# Ejemplo: https://saangelr10.github.io,http://localhost:5500
PUBLIC_ORIGIN_ALLOWLIST=""
